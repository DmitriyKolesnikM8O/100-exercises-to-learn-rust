{
  // ---------------------------------------------------------------------------
  // Локальные настройки для упражнений (файл не входит в git-репозиторий).
  // ---------------------------------------------------------------------------

  // 98 упражнений лежат в одном Cargo-workspace, и нерешённые ещё не
  // компилируются. Проверяем только то упражнение, которое открыто сейчас,
  // иначе во всех файлах сразу будет висеть куча ошибок.
  "rust-analyzer.check.workspace": false,

  // Подстраховка: гарантируем, что rust-analyzer найдёт rustup/cargo/rustc,
  // даже если Antigravity был запущен до установки Rust.
  "rust-analyzer.server.extraEnv": {
    "PATH": "C:\\Users\\user\\.cargo\\bin;${env:PATH}"
  },

  // Ошибки компилятора в этом курсе — часть обучения, поэтому не форматируем
  // и не «исправляем» код автоматически при сохранении.
  "[rust]": {
    "editor.formatOnSave": false
  }
}
